{
  "datasets": [
    {
      "name": "ds_ventas",
      "displayName": "Ventas Gold",
      "queryLines": [
        "SELECT region, region_nombre, categoria, mes, usuarios_unicos, total_compras, ingresos_totales, ticket_promedio FROM proyecto_nota3.gold.gold_sales_summary"
      ]
    },
    {
      "name": "ds_usuarios",
      "displayName": "Métricas por usuario",
      "queryLines": [
        "SELECT user_id, region, total_compras_usuario, gasto_total_usuario, gasto_promedio_usuario, ultima_compra FROM proyecto_nota3.gold.gold_user_metrics"
      ]
    },
    {
      "name": "ds_esp32",
      "displayName": "Eventos IoT (ESP32)",
      "queryLines": [
        "SELECT event_id, device_id, event_type, categoria, region, amount, quantity, total_amount,\n",
        "from_utc_timestamp(ingestion_time, 'America/Bogota') AS hora_bogota\n",
        "FROM proyecto_nota3.gold.vw_eventos_esp32"
      ]
    },
    {
      "name": "ds_esp32_minuto",
      "displayName": "Ritmo IoT por minuto",
      "queryLines": [
        "SELECT date_trunc('minute', from_utc_timestamp(ingestion_time, 'America/Bogota')) AS minuto, region, categoria, COUNT(*) AS eventos\n",
        "FROM proyecto_nota3.gold.vw_eventos_esp32\n",
        "WHERE ingestion_time >= current_timestamp() - INTERVAL 2 HOURS\nGROUP BY ALL"
      ]
    },
    {
      "name": "ds_capas",
      "displayName": "Filas por capa Medallón",
      "queryLines": [
        "SELECT '1. Bronze' AS capa, COUNT(*) AS filas FROM proyecto_nota3.bronze.eventos_raw\nUNION ALL\n",
        "SELECT '2. Silver', COUNT(*) FROM proyecto_nota3.silver.silver_events\nUNION ALL\n",
        "SELECT '3. Gold (ventas)', COUNT(*) FROM proyecto_nota3.gold.gold_sales_summary\nUNION ALL\n",
        "SELECT '3. Gold (usuarios)', COUNT(*) FROM proyecto_nota3.gold.gold_user_metrics"
      ]
    },
    {
      "name": "ds_calidad",
      "displayName": "Calidad de datos Bronze",
      "queryLines": [
        "SELECT COUNT(*) AS filas_bronze, COUNT(*) - COUNT(DISTINCT event_id) AS duplicados,\n",
        "SUM(CASE WHEN amount <= 0 THEN 1 ELSE 0 END) AS montos_invalidos,\n",
        "SUM(CASE WHEN category <> UPPER(TRIM(category)) THEN 1 ELSE 0 END) AS categorias_sucias,\n",
        "SUM(CASE WHEN source = 'ESP32' THEN 1 ELSE 0 END) AS filas_iot\n",
        "FROM proyecto_nota3.bronze.eventos_raw"
      ]
    },
    {
      "name": "ds_origen",
      "displayName": "Bronze por origen",
      "queryLines": [
        "SELECT source AS origen, event_type, COUNT(*) AS filas FROM proyecto_nota3.bronze.eventos_raw GROUP BY ALL"
      ]
    }
  ],
